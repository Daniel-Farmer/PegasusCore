# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/

# production
/build

# env files — keep example files for onboarding
.env*
!.env*.example

# secrets catch-all
*.pem
*.key
*.cert
*.p12
credentials.json
.npmrc

# databases (local SQLite etc.)
*.db
*.sqlite
*.sqlite3

# logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# supabase local
.supabase/

# bifrost local
bifrost-*.db

# flowise local data
.flowise/

# claude code (ignore all except shared configs)
.claude/*
!.claude/launch.json

# editor configs
.vscode/
.idea/

# OS clutter
.DS_Store
._*
Thumbs.db
Desktop.ini
ehthumbs.db
.Spotlight-V100
.Trashes

# temp/swap/backup files
*.tmp
*.swp
*.swo
*~
*.bak
*.orig

# node
.node_repl_history
.eslintcache

# module runtime data
modules/traefik/acme/
lib/bullmq/

# docker
docker-compose.override.yml

# coolify
.coolify

# typescript
*.tsbuildinfo
next-env.d.ts
