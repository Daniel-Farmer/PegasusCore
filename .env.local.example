# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Bifrost AI Gateway
BIFROST_BASE_URL=http://localhost:8080/openai
BIFROST_API_KEY=bifrost-internal

# Flowise
FLOWISE_BASE_URL=http://localhost:3001
FLOWISE_CHATFLOW_ID=your-chatflow-id
FLOWISE_API_KEY=

# Redis (uncomment if enabled)
# REDIS_URL=redis://localhost:6379

# Qdrant (uncomment if enabled)
# QDRANT_URL=http://localhost:6333

# Weaviate (uncomment if enabled)
# WEAVIATE_URL=http://localhost:8085

# MinIO (uncomment if enabled)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# Meilisearch (uncomment if enabled)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_KEY=pegasus-meili-key

# Temporal (uncomment if enabled)
# TEMPORAL_ADDRESS=localhost:7233

# NATS (uncomment if enabled)
# NATS_URL=nats://localhost:4222

# Vault (uncomment if enabled)
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=pegasus-vault-dev-token

# Sentry (uncomment if enabled)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# OpenTelemetry (uncomment if enabled)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# GPU Nodes (uncomment if enabled)
# GPU_PROVIDER=runpod|vast|self-hosted
# GPU_API_KEY=
# GPU_ENDPOINT=http://localhost:8000

# Database URL (for Drizzle/Prisma — use Supabase connection string)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
